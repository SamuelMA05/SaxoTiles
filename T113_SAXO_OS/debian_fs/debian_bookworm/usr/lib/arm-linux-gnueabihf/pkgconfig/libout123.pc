prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/arm-linux-gnueabihf
includedir=${prefix}/include/arm-linux-gnueabihf

Name: libout123
Description: A streaming audio output API derived from mpg123
Requires: 
Version: 1.31.2
Libs: -L${libdir} -lout123 
Libs.private: -lm  
Cflags: -I${includedir} 
