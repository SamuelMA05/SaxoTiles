#! /bin/bash -e

faust2svg $@

for d in $@; do
    ext=${d##*.}
    if [ $ext = "dsp" ]; then
        name=${d%.dsp}
        cd $name-svg
        for f in *.svg; do
            #inkscape -E ${f%.svg}.eps $f
            #epstopdf ${f%.svg}.eps
	    inkscape -o "${f%.svg}.pdf" "${f}"
            rm $f
        done
        cd ..
        mv $name-svg $name-pdf
    fi
done

